---
import { Image } from 'astro:assets';
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../styles.css';
import logo from '../../../docs/assets/yang-icon.png';
import player from '../../../docs/screenshots/player.png';
import library from '../../../docs/screenshots/songs.webp';
import hifi from '../../../docs/screenshots/hifi.png';

const repository = 'https://github.com/zXer0z/Yang-Player';
const download = repository + '/releases/latest';
const description = 'Reproductor Android de código abierto. Música local, tu servidor Navidrome, carátulas dinámicas y un motor Hi-Fi configurable.';
const features = [
  {
    id: 'player', tab: 'Reproductor', image: player, alt: 'Reproductor de Yang con carátula circular en modo vinilo',
    title: 'La carátula se apodera de la pantalla.',
    text: 'El color cambia con cada álbum. Desliza la portada para cambiar de pista y abre la cola o las letras sincronizadas desde el reproductor.',
    tags: ['Tema dinámico', 'Modo vinilo', 'Letras sincronizadas']
  },
  {
    id: 'library', tab: 'Biblioteca', image: library, alt: 'Lista de canciones de Yang con búsqueda, filtros y orden separados',
    title: 'Toda tu colección, en un mismo lugar.',
    text: 'Explora por álbum, artista o carpeta. Ordena y filtra por separado, crea playlists y recupera la última sesión cuando vuelvas.',
    tags: ['Favoritos', 'Playlists', 'Carpetas']
  },
  {
    id: 'hifi', tab: 'Hi-Fi', image: hifi, alt: 'Pantalla Hi-Fi de Yang Player',
    title: 'Ajustes a la medida de tu equipo.',
    text: 'Guarda un perfil para altavoz, Bluetooth, Jack/AUX o USB. El monitor muestra el espectro, el pico, el RMS y el factor de cresta de la señal PCM.',
    tags: ['EQ de 10 bandas', 'Perfiles de salida', 'Monitor PCM']
  }
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#10110d" />
    <meta name="description" content={description} />
    <meta property="og:title" content="Yang Player · Reproductor Hi-Fi para Android" />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/png" href={logo.src} />
    <title>Yang Player · Reproductor Hi-Fi para Android</title>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="site-header shell">
      <a class="brand" href="#contenido" aria-label="Yang Player, inicio">
        <Image src={logo} alt="" width={38} height={38} />
        <span>YANG<span class="brand-player"> PLAYER</span></span>
      </a>
      <nav aria-label="Navegación principal">
        <a href="#experiencia">Explorar</a>
        <a href="#motor">Motor Hi-Fi</a>
        <a class="nav-repo" href={repository}>GitHub</a>
      </nav>
    </header>
    <main id="contenido">
      <section class="hero shell">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Reproductor Hi-Fi para Android</p>
          <h1>Tu música.<br /><em>Tu sonido.</em></h1>
          <p class="intro">Dale vida a tus portadas, escucha tu colección local o por Navidrome y ajusta el sonido para cada salida.</p>
          <div class="actions">
            <a class="button primary" href={download}>Descargar para Android</a>
            <a class="button secondary" href="#experiencia">Explorar Yang</a>
          </div>
          <p class="requirements">Android 8.0+ <span>·</span> Código abierto <span>·</span> Motor local sin root</p>
        </div>
        <div class="hero-visual" data-tilt>
          <div class="hero-halo" aria-hidden="true"></div>
          <div class="vinyl" aria-hidden="true">
            <div class="vinyl-label"></div>
          </div>
          <div class="phone-wrap">
            <figure class="phone hero-phone">
              <Image src={player} alt="Yang Player con un disco en modo vinilo y controles de reproducción" width={521} format="webp" quality={86} loading="eager" fetchpriority="high" />
            </figure>
          </div>
          <div class="hero-caption" aria-hidden="true"><span></span> MODO VINILO · YANG + YIN</div>
        </div>
      </section>

      <section id="experiencia" class="section showcase shell">
        <div class="section-heading">
          <p class="eyebrow">En pantalla</p>
          <h2>Explora Yang.</h2>
        </div>
        <div class="showcase-card" data-showcase>
          <div class="tabs" role="tablist" aria-label="Pantallas de Yang">
            {features.map((feature, index) => (
              <button type="button" role="tab" id={`tab-${feature.id}`} aria-controls={`panel-${feature.id}`}
                aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>{feature.tab}</button>
            ))}
          </div>
          {features.map((feature, index) => (
            <article class:list={['showcase-panel', feature.id]} id={`panel-${feature.id}`} role="tabpanel" aria-labelledby={`tab-${feature.id}`} tabindex="0" hidden={index !== 0}>
              <div class="showcase-copy">
                <h3>{feature.title}</h3>
                <p>{feature.text}</p>
                <ul class="feature-tags">{feature.tags.map((tag) => <li>{tag}</li>)}</ul>
              </div>
              <div class="showcase-image">
                <div class="showcase-orbit" aria-hidden="true"></div>
                <figure class="phone">
                  <Image src={feature.image} alt={feature.alt} width={510} format="webp" quality={82} loading="lazy" />
                </figure>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="motor" class="section engine shell">
        <div class="engine-copy">
          <p class="eyebrow">El motor de audio</p>
          <h2>Control de la<br /><em>señal al detalle.</em></h2>
          <p>Yang procesa PCM en su motor nativo. Ajusta frecuencia, ganancia y Q en diez bandas paramétricas y controla el preamplificador y el limitador por salida.</p>
          <p>En dispositivos compatibles, Yin Control puede encargarse de la salida. El puente local verifica la firma de ambas apps antes de entregar el PCM.</p>
          <a class="text-link" href={repository + '/blob/main/docs/audio-engine.md'}>Documentación del motor</a>
        </div>
        <div class="signal" data-signal>
          <div class="signal-header"><span>Espectro de ejemplo</span><button type="button" aria-pressed="false" hidden>Animar</button></div>
          <div class="spectrum" aria-hidden="true">
            {Array.from({ length: 40 }, (_, i) => (
              <span style={`--level:${Math.round(17 + 65 * Math.exp(-(((i - 13) / 9) ** 2)) + 23 * Math.sin(i * .47) ** 2)}%;--phase:${-i * .071}s;--tempo:${.72 + (i % 8) * .08}s`}></span>
            ))}
          </div>
          <div class="frequencies" aria-hidden="true"><span>32 Hz</span><span>250 Hz</span><span>1 kHz</span><span>8 kHz</span><span>16 kHz</span></div>
          <div class="signal-footer">
            <div><strong>10</strong><span>Bandas de EQ</span></div>
            <div><strong>PCM</strong><span>Monitor de entrada</span></div>
            <div><strong>4</strong><span>Tipos de salida</span></div>
          </div>
        </div>
      </section>

      <section class="section server shell">
        <div class="server-card">
          <div class="network-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
          <div>
            <p class="eyebrow">Navidrome</p>
            <h2>Escucha desde<br />tu propio servidor.</h2>
            <p>Configura la URL HTTPS de tu Navidrome y elige la calidad de reproducción. Desliza hacia abajo en Canciones para actualizar el catálogo.</p>
          </div>
          <a class="button secondary" href={repository + '#navidrome'}>Configurar Navidrome</a>
        </div>
      </section>

      <section class="section closing shell">
        <Image src={logo} alt="" width={68} height={68} />
        <h2>Yang Player para Android</h2>
        <div class="actions">
          <a class="button primary" href={download}>Descargar APK</a>
          <a class="button secondary" href={repository}>Ver código</a>
        </div>
      </section>
    </main>
    <footer class="site-footer shell">
      <span>Yang Player · GPL‑3.0‑or‑later</span>
      <a href={repository + '/blob/main/LICENSE'}>Licencia</a>
    </footer>

    <script>
      const showcase = document.querySelector<HTMLElement>('[data-showcase]');
      const tabs = [...(showcase?.querySelectorAll<HTMLButtonElement>('[role="tab"]') ?? [])];

      function showTab(tab: HTMLButtonElement, focus = false) {
        for (const candidate of tabs) {
          const selected = candidate === tab;
          candidate.setAttribute('aria-selected', String(selected));
          candidate.tabIndex = selected ? 0 : -1;
          const panel = document.getElementById(candidate.getAttribute('aria-controls') ?? '');
          if (panel) panel.hidden = !selected;
        }
        if (focus) tab.focus();
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => showTab(tab));
        tab.addEventListener('keydown', (event) => {
          const next = {
            ArrowRight: (index + 1) % tabs.length,
            ArrowLeft: (index + tabs.length - 1) % tabs.length,
            Home: 0,
            End: tabs.length - 1
          }[event.key];
          if (next === undefined) return;
          event.preventDefault();
          const target = tabs[next];
          if (target) showTab(target, true);
        });
      });

      const signal = document.querySelector<HTMLElement>('[data-signal]');
      const signalToggle = signal?.querySelector('button');
      if (signal && signalToggle) {
        signalToggle.hidden = false;
        signalToggle.addEventListener('click', () => {
          const playing = signal.classList.toggle('is-moving');
          signalToggle.setAttribute('aria-pressed', String(playing));
          signalToggle.textContent = playing ? 'Pausar' : 'Animar';
        });
      }

      const motion = window.matchMedia('(prefers-reduced-motion: no-preference) and (pointer: fine)');
      const hero = document.querySelector<HTMLElement>('[data-tilt]');
      if (hero) {
        const reset = () => {
          hero.style.removeProperty('--shift-x');
          hero.style.removeProperty('--shift-y');
        };
        hero.addEventListener('pointermove', (event) => {
          if (!motion.matches) return;
          const bounds = hero.getBoundingClientRect();
          hero.style.setProperty('--shift-x', `${((event.clientX - bounds.left) / bounds.width - .5) * 22}px`);
          hero.style.setProperty('--shift-y', `${((event.clientY - bounds.top) / bounds.height - .5) * 18}px`);
        });
        hero.addEventListener('pointerleave', reset);
        motion.addEventListener('change', reset);
      }
    </script>
  </body>
</html>
